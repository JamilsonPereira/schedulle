# Copie para .env (não versionado) ou configure na Run Configuration da IDE
DB_URL=jdbc:postgresql://localhost:5432/agenda
DB_USER=agenda
DB_PASSWORD=agenda

# Meta for Developers > seu app > WhatsApp
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-aleatorio
WHATSAPP_APP_SECRET=app-secret-do-app-na-meta
WHATSAPP_ACCESS_TOKEN=token-temporario-ou-de-usuario-de-sistema
WHATSAPP_API_VERSION=v23.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# Segurança (Passo 2). Sem as chaves, um par RSA temporário é gerado a cada start.
JWT_CHAVE_PRIVADA_PEM=
JWT_CHAVE_PUBLICA_PEM=
# Habilita POST /api/v1/plataforma/clinicas (onboarding). Vazio = rota desligada.
PLATAFORMA_TOKEN=
